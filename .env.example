# Copy this file to .env and adjust values.

# PostgreSQL connection.
# Local dev (portable postgres bundled in this repo): see README "Database".
DATABASE_URL=postgresql://talentgraph@127.0.0.1:5432/talentgraph

# Express API port (Vite proxies /api and /uploads to it in development)
PORT=4000
NODE_ENV=development

# Secret used to sign JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Initial platform administrator created by `npm run db:seed` (dev seed only).
ADMIN_EMAIL=admin@talentgraph.local
ADMIN_PASSWORD=ChangeMe!2024
